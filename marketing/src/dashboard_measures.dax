PSA variance share = 0.9441517970281729

-- Table: Experiment
Fisher exact p = 1.0470720577954195e-14

-- Table: Experiment
Illustrative break-even CPM = 7.747190157488119

-- Table: Experiment
Required PSA users = VAR p0=SELECTEDVALUE(Baseline[Value],0.018)
VAR lift=SELECTEDVALUE('Target lift'[Value],0.20)
VAR pw=SELECTEDVALUE(Power[Value],0.80)
VAR a=SELECTEDVALUE('Ad allocation'[Value],0.50)
VAR p1=p0*(1+lift)
VAR r=DIVIDE(a,1-a)
VAR pb=DIVIDE(p0+r*p1,1+r)
VAR za=NORM.S.INV(0.975)
VAR zb=NORM.S.INV(pw)
VAR n0=ROUNDUP(DIVIDE(POWER(za*SQRT((1+1/r)*pb*(1-pb))+zb*SQRT(p0*(1-p0)+p1*(1-p1)/r),2),POWER(p1-p0,2)),0)
RETURN IF(p1<1,n0)

-- Table: Experiment
Required ad users = ROUNDUP([Required PSA users]*DIVIDE(SELECTEDVALUE('Ad allocation'[Value],0.5),1-SELECTEDVALUE('Ad allocation'[Value],0.5)),0)

-- Table: Experiment
Required experiment users = [Required PSA users]+[Required ad users]

-- Table: Experiment
Curve total users = VAR p0=SELECTEDVALUE(Baseline[Value],0.018)
VAR lift=SELECTEDVALUE('Lift curve'[Value],0.20)
VAR pw=SELECTEDVALUE(Power[Value],0.80)
VAR a=SELECTEDVALUE('Ad allocation'[Value],0.50)
VAR p1=p0*(1+lift)
VAR r=DIVIDE(a,1-a)
VAR pb=DIVIDE(p0+r*p1,1+r)
VAR za=NORM.S.INV(0.975)
VAR zb=NORM.S.INV(pw)
VAR n0=ROUNDUP(DIVIDE(POWER(za*SQRT((1+1/r)*pb*(1-pb))+zb*SQRT(p0*(1-p0)+p1*(1-p1)/r),2),POWER(p1-p0,2)),0)
RETURN IF(p1<1,n0+ROUNDUP(n0*r,0))

-- Table: Planning
Required total users = SUM(Planning[Total users])

-- Table: Evidence
95% interval = 1

-- Table: Evidence
Estimate = IF(ABS(SELECTEDVALUE(Evidence[Lift pp])-0.7692453192201517)<0.0000001,1,BLANK())