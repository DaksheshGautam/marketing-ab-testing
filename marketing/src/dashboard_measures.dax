-- Table: Experiment
Users = SUM(Experiment[Users count])

-- Table: Experiment
Conversions = SUM(Experiment[Conversions count])

-- Table: Experiment
Impressions = SUM(Experiment[Impressions count])

-- Table: Experiment
Conversion rate = DIVIDE([Conversions],[Users])

-- Table: Experiment
Ads per user = DIVIDE([Impressions],[Users])

-- Table: Experiment
PSA rate = CALCULATE([Conversion rate],REMOVEFILTERS(Experiment[Variant]),Experiment[Variant]="A | PSA control")

-- Table: Experiment
Ad rate = CALCULATE([Conversion rate],REMOVEFILTERS(Experiment[Variant]),Experiment[Variant]="B | Product ads")

-- Table: Experiment
PSA users = CALCULATE([Users],REMOVEFILTERS(Experiment[Variant]),Experiment[Variant]="A | PSA control")

-- Table: Experiment
Ad users = CALCULATE([Users],REMOVEFILTERS(Experiment[Variant]),Experiment[Variant]="B | Product ads")

-- Table: Experiment
Lift pp = IF([PSA users]>0 && [Ad users]>0,100*([Ad rate]-[PSA rate]))

-- Table: Experiment
Relative lift = DIVIDE([Ad rate]-[PSA rate],[PSA rate])

-- Table: Experiment
Modeled incremental conversions = [Ad users]*([Ad rate]-[PSA rate])

-- Table: Experiment
Total impressions, full cohort = CALCULATE([Impressions],REMOVEFILTERS(Experiment))

-- Table: Experiment
Full cohort p-value = 1.705280716155973e-13

